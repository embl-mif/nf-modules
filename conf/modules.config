nextflow.enable.moduleBinaries = true

process {
    withName: 'RUN_ULTRACK' {
        clusterOptions = '--constraint="gpu=L40s|gpu=A100" -G 1'   // anything except RTX PRO 6000 (Blackwell)
        publishDir = [
            path: { new File(meta.zarr_output).parent },
            mode: 'copy',
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.zarr')) ? null : filename }
        ]
    }
}
