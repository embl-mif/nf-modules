nextflow.enable.moduleBinaries = true

process {
    withName: 'RUN_ULTRACK' {
        // GPU type, partition and memory come from the 'gpu' label (conf/embl_hd.config), which
        // already leaves out the Blackwell (RTX PRO 6000) GPUs this CUDA 12.4 image cannot use.
        publishDir = [
            path: { new File(meta.zarr_output).parent },
            mode: 'copy',
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.zarr')) ? null : filename }
        ]
    }
}
