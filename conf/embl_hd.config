params {
    config_profile_name        = 'EMBL_HD'
    config_profile_description = 'EMBL Heidelberg cluster profile'
    config_profile_url         = 'https://git.embl.de/data-sciences/sci-workflows/nextflow-config'
}

apptainer {
    enabled        = true
    autoMounts     = true
    docker.enabled = false

    runOptions = '-H $PWD'

    cacheDir       = "/g/mif-hd/shared/cache_apptainer/" //or can use scratch
    pullTimeout    = "3 hours"
    envWhitelist   = 'CUDA_VISIBLE_DEVICES'
}

conda {
    enabled = true
    useMamba = true
    cacheDir = "/g/mif-hd/shared/conda_envs"
}


executor {
    name            = "slurm"
    queue           = 'htc-el8'
    scratch         = true
    queueSize       = 200
    submitRateLimit = "10/1sec"
    pollInterval    = "10sec"
    exitReadTimeout = "5 min"
}


process {
    cache         = 'lenient'
    maxRetries    = 3
    afterScript   = 'sleep 10'
    beforeScript  ="""
        if [ -n "\$CONDA_PREFIX" ]; then
            export PATH="\$CONDA_PREFIX/bin:\$PATH"
            export LD_LIBRARY_PATH="\$CONDA_PREFIX/lib:\$LD_LIBRARY_PATH"
        fi
        """.stripIndent()
    queue = { (task.time <= 14.d && task.memory < 256.GB && (task.memory.div(task.cpus)) <= 4.GB) ? "htc-el8" : "bigmem" }

    containerOptions = {
        def binds = ''
        try {
            def q = { v -> "'" + v.toString().replace("'", "'\"'\"'") + "'" }
            def m = meta instanceof Map ? meta : [:]
            binds = m.findAll { k, v -> k.toString() in ['zarr_output', 'csv_output', 'summary_csv_output'] && v && new File(v.toString()).isAbsolute() }
                .values()
                .collect { new File(it.toString()).parentFile.path }
                .unique()
                .collect { d -> new File(d).mkdirs(); "--bind ${q(d)}:${q(d)}" }
                .join(' ')
        } catch (MissingPropertyException e) { }
        binds
    }

    withLabel: 'gpu' {
        queue            = 'gpu-el8'
        containerOptions = {
            def binds = ''
            try {
                def q = { v -> "'" + v.toString().replace("'", "'\"'\"'") + "'" }
                def m = meta instanceof Map ? meta : [:]
                binds = m.findAll { k, v -> k.toString() in ['zarr_output', 'csv_output', 'summary_csv_output'] && v && new File(v.toString()).isAbsolute() }
                    .values()
                    .collect { new File(it.toString()).parentFile.path }
                    .unique()
                    .collect { d -> new File(d).mkdirs(); "--bind ${q(d)}:${q(d)}" }
                    .join(' ')
            } catch (MissingPropertyException e) { }
            "--nv ${binds}".trim() // --nv enables NVIDIA support
        }
        // Host RAM, not GPU memory, limits a Cellpose tile: measured with Cellpose-SAM 4.1.1,
        // 3D, diameter 15 on an A100 (2026-11), about 2.7 GB + 329 bytes per input voxel
        // (25 bytes per voxel on the GPU). 120 GB is the RAM per GPU of the A100 nodes
        // (1 TB / 8 GPUs), so tiles of up to ~300 M voxels (halo included) fit the first
        // attempt: plan_tiles(..., max_tile_voxels=300_000_000).
        // This overrides process_high's 72 GB (base.config) because embl_hd.config is
        // included after base.config: with two matching labels, the one read last wins.
        memory           = { check_max( 120.GB * task.attempt, 'memory' ) }
        // A100, L40s and H100 nodes only: they have >= 129 GB of RAM per GPU. The 3090
        // nodes have 64 GB per GPU; the RTX PRO 6000 (Blackwell) nodes are avoided as for
        // RUN_ULTRACK (which sets its own clusterOptions in modules.config).
        clusterOptions   = '--gres=gpu:1 --constraint="gpu=A100|gpu=L40s|gpu=H100"'
    }

    withLabel: 'bigmem' {
        queue = 'bigmem'
    }

    withLabel:low_qos {
        clusterOptions = '--qos=low'
    }
}


