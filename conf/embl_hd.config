params {
    config_profile_name        = 'EMBL_HD'
    config_profile_description = 'EMBL Heidelberg cluster profile'
    config_profile_url         = 'https://git.embl.de/data-sciences/sci-workflows/nextflow-config'

    // SLURM partitions (el10, checked against the cluster wiki and the cluster architect's
    // migration notes, confirmed 2026-11-26). "-el10" is to be dropped from the partition
    // names in the January 2027 maintenance: change them here, or pass e.g. --cpu_queue htc.
    cpu_queue    = 'htc-el10'
    bigmem_queue = 'bigmem-el10'
    gpu_queue    = 'gpu-el10'
}

apptainer {
    enabled        = true
    autoMounts     = true
    docker.enabled = false

    runOptions = '-H $PWD'

    cacheDir       = "/g/mif-hd/shared/cache_apptainer/" //or can use scratch
    pullTimeout    = "3 hours"
    envWhitelist   = 'CUDA_VISIBLE_DEVICES'
}

conda {
    enabled = true
    useMamba = true
    cacheDir = "/g/mif-hd/shared/conda_envs"
    // The Cellpose environment downloads PyTorch with its CUDA libraries (several GB); the default
    // limit (20 min) can be too short for the first run.
    createTimeout = "1 h"
}


executor {
    name            = "slurm"
    queue           = params.cpu_queue
    scratch         = true
    queueSize       = 200
    submitRateLimit = "10/1sec"
    pollInterval    = "10sec"
    exitReadTimeout = "5 min"
}


process {
    cache         = 'lenient'
    maxRetries    = 3
    afterScript   = 'sleep 10'
    beforeScript  ="""
        if [ -n "\$CONDA_PREFIX" ]; then
            export PATH="\$CONDA_PREFIX/bin:\$PATH"
            export LD_LIBRARY_PATH="\$CONDA_PREFIX/lib:\$LD_LIBRARY_PATH"
        fi
        """.stripIndent()
    queue = { (task.time <= 14.d && task.memory < 256.GB && (task.memory.div(task.cpus)) <= 4.GB) ? params.cpu_queue : params.bigmem_queue }

    containerOptions = {
        def binds = ''
        try {
            def q = { v -> "'" + v.toString().replace("'", "'\"'\"'") + "'" }
            def m = meta instanceof Map ? meta : [:]
            binds = m.findAll { k, v -> k.toString() in ['zarr_output', 'csv_output', 'summary_csv_output'] && v && new File(v.toString()).isAbsolute() }
                .values()
                .collect { new File(it.toString()).parentFile.path }
                .unique()
                .collect { d -> new File(d).mkdirs(); "--bind ${q(d)}:${q(d)}" }
                .join(' ')
        } catch (MissingPropertyException e) { }
        binds
    }

    withLabel: 'gpu' {
        queue            = params.gpu_queue
        containerOptions = {
            def binds = ''
            try {
                def q = { v -> "'" + v.toString().replace("'", "'\"'\"'") + "'" }
                def m = meta instanceof Map ? meta : [:]
                binds = m.findAll { k, v -> k.toString() in ['zarr_output', 'csv_output', 'summary_csv_output'] && v && new File(v.toString()).isAbsolute() }
                    .values()
                    .collect { new File(it.toString()).parentFile.path }
                    .unique()
                    .collect { d -> new File(d).mkdirs(); "--bind ${q(d)}:${q(d)}" }
                    .join(' ')
            } catch (MissingPropertyException e) { }
            "--nv ${binds}".trim() // --nv enables NVIDIA support
        }
        // Host RAM, not GPU memory, limits a Cellpose tile: measured with Cellpose-SAM 4.1.1,
        // 3D, diameter 15 on an A100 (2026-11), about 2.7 GB + 329 bytes per input voxel
        // (25 bytes per voxel on the GPU), so tiles of up to ~300 M voxels (halo included)
        // fit the first attempt: plan_tiles(..., max_tile_voxels=300_000_000).
        // This overrides process_high's 72 GB (base.config) because embl_hd.config is
        // included after base.config: with two matching labels, the one read last wins.
        //
        // Memory and GPU type go up together, keeping each request within one GPU's share
        // of its node (RAM per GPU from the cluster wiki, checked 2026-11-26; Nextflow's GB
        // is GiB and SLURM's --mem is MiB):
        //   attempt 1: 120 GB on A100 | L40s | H100 | A40   (A100 share: 128789 MB)
        //   attempt 2: 188 GB on L40s | H100 | A40           (L40s / H100 share: 193153 MB)
        //   attempt 3+: 480 GB on A40                         (A40: one GPU per node, 514286 MB)
        // process_high's 12 CPUs x attempt stays within the CPUs per GPU of each type.
        // Left out: the 3090 nodes (64 GB of RAM per GPU) and the Blackwell RTX PRO 6000
        // nodes (the Ultrack image is built for CUDA 12.4; Cellpose is untested there).
        // RUN_ULTRACK uses these settings too.
        memory           = { check_max( task.attempt == 1 ? 120.GB : (task.attempt == 2 ? 188.GB : 480.GB), 'memory' ) }
        clusterOptions   = {
            def gpus = 'gpu=A40'
            if (task.attempt == 1) { gpus = 'gpu=A100|gpu=L40s|gpu=H100|gpu=A40' }
            if (task.attempt == 2) { gpus = 'gpu=L40s|gpu=H100|gpu=A40' }
            "--gres=gpu:1 --constraint=\"${gpus}\""
        }
    }

    withLabel: 'bigmem' {
        queue = params.bigmem_queue
    }

    withLabel:low_qos {
        clusterOptions = '--qos=low'
    }
}


